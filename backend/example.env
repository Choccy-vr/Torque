# Either a Npgsql connection string, or (e.g. in Docker) a postgres://user:pass@host:port/db
# URL in DATABASE_URL instead.
DB_CONNECTION_STRING=Host=<HOST>;Port=<PORT>;Database=postgres;Username=<username>;Password=<PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=your-jwt-secret
# Public anon key, used by the /testing harness page. `supabase status` prints it.
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key (server only — never ship to a browser). Used by the Airtable push
# to read a submitter's name/birthday/address claims. `supabase status` prints it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# OIDC provider identifier users sign in with: the frontend (via /config.js in the Docker
# image) and the /testing harness both use it
OIDC_PROVIDER=custom:hackclub-auth

# Hackatime OAuth app credentials (register at https://hackatime.hackclub.com).
# Redirect URI must match exactly what's registered with the OAuth app: the frontend's
# /auth/hackatime/callback page (https://<your-domain>/auth/hackatime/callback in
# production). The /testing harness uses http://localhost:5267/auth/hackatime/callback.
HACKATIME_CLIENT_ID=your-hackatime-client-id
HACKATIME_CLIENT_SECRET=your-hackatime-client-secret
HACKATIME_REDIRECT_URI=http://localhost:5173/auth/hackatime/callback
HACKATIME_BASE_URL=https://hackatime.hackclub.com

# Shared program key for lapse.hackclub.com (ask a Lapse admin for one), used to
# look up a project owner's timelapses in the reviewer view. Leave unset to disable.
LAPSE_BASE_URL=https://api.lapse.hackclub.com
LAPSE_PROGRAM_KEY=your-lapse-program-key

# Airtable personal access token (scope data.records:write on the base) + base/table
# that first-pass-approved projects are pushed to. Leave API key unset to disable.
AIRTABLE_API_KEY=your-airtable-pat
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=YSWS Project Submission
# Shared secret the Airtable approval automation sends in the X-Webhook-Secret header
# to POST /api/airtable/approve (e.g. `openssl rand -hex 32`, 32+ characters). Leave
# unset to disable.
AIRTABLE_WEBHOOK_SECRET=your-airtable-webhook-secret

# Slack app bot token (xoxb-...). Scopes: chat:write + im:write for DMs, channels:manage
# + groups:write to invite users to public/private channels. Leave unset to disable.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Comma-separated channel IDs that POST /api/slack/channels/join invites the caller to.
# The bot must already be a member of each one.
SLACK_JOIN_CHANNELS=C0123ABC,C0456DEF

# 32-byte AES-256 key, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts
# tokens stored at rest (e.g. User.HackatimeToken). Rotating this makes existing
# encrypted values unreadable, so treat it like any other production secret.
TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Docker image only. Port to listen on (default 8080), and set MIGRATE_ON_STARTUP=false to
# stop the container applying pending migrations on boot (on by default outside Development).
# PORT=8080
# MIGRATE_ON_STARTUP=true
