DB_CONNECTION_STRING=Host=<HOST>;Port=<PORT>;Database=postgres;Username=<username>;Password=<PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
FRONTEND_URL=http://localhost:9999
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=your-jwt-secret
# Public anon key, used by the /testing harness page. `supabase status` prints it.
SUPABASE_ANON_KEY=your-supabase-anon-key
# OIDC provider identifier the /testing harness signs in with
TESTING_OIDC_PROVIDER=custom:hackclub-auth

# Hackatime OAuth app credentials (register at https://hackatime.hackclub.com).
# Redirect URI must match exactly what's registered with the OAuth app. Pointed at
# the backend's own /testing harness for now (see testing/README.md) since there's
# no frontend callback route yet — switch to the real frontend once there is one.
HACKATIME_CLIENT_ID=your-hackatime-client-id
HACKATIME_CLIENT_SECRET=your-hackatime-client-secret
HACKATIME_REDIRECT_URI=http://localhost:5267/auth/hackatime/callback
HACKATIME_BASE_URL=https://hackatime.hackclub.com

# Shared program key for lapse.hackclub.com (ask a Lapse admin for one), used to
# look up a project owner's timelapses in the reviewer view. Leave unset to disable.
LAPSE_BASE_URL=https://lapse.hackclub.com
LAPSE_PROGRAM_KEY=your-lapse-program-key

# 32-byte AES-256 key, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts
# tokens stored at rest (e.g. User.HackatimeToken). Rotating this makes existing
# encrypted values unreadable, so treat it like any other production secret.
TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
