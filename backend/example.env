# Either a Npgsql connection string, or (e.g. in Docker) a postgres://user:pass@host:port/db
# URL in DATABASE_URL instead. This one matches the `db` service in compose.yaml
# (`docker compose up -d db`); a hosted Postgres usually also wants SSL Mode=Require.
DB_CONNECTION_STRING=Host=127.0.0.1;Port=5432;Database=torque;Username=torque;Password=torque
FRONTEND_URL=http://localhost:5173

# Hack Club Auth OIDC app (create one at https://auth.hackclub.com/developer/apps).
# Its redirect URI must be this backend's /auth/callback, e.g.
# http://localhost:5267/auth/callback locally, https://<your-domain>/auth/callback in production.
HCA_CLIENT_ID=your-hca-client-id
HCA_CLIENT_SECRET=your-hca-client-secret
# Optional. Defaults to https://auth.hackclub.com.
# HCA_URL=https://auth.hackclub.com
# Optional, space-separated. The default also asks for address + birthdate (used by the
# Airtable push), which need an HQ-official app; a community app can only get
# "openid profile email name slack_id verification_status".
# HCA_SCOPES=openid profile email name slack_id verification_status address birthdate

# Secret that HMAC-signs the Hackatime OAuth `state` (e.g. `openssl rand -hex 32`).
OAUTH_STATE_SECRET=your-oauth-state-secret

# Hackatime OAuth app credentials (register at https://hackatime.hackclub.com).
# Redirect URI must match exactly what's registered with the OAuth app: the frontend's
# /auth/hackatime/callback page (https://<your-domain>/auth/hackatime/callback in
# production). The /testing harness uses http://localhost:5267/auth/hackatime/callback.
HACKATIME_CLIENT_ID=your-hackatime-client-id
HACKATIME_CLIENT_SECRET=your-hackatime-client-secret
HACKATIME_REDIRECT_URI=http://localhost:5173/auth/hackatime/callback
HACKATIME_BASE_URL=https://hackatime.hackclub.com

# Shared program key for lapse.hackclub.com (ask a Lapse admin for one), used to
# look up a project owner's timelapses in the reviewer view. Leave unset to disable.
LAPSE_BASE_URL=https://api.lapse.hackclub.com
LAPSE_PROGRAM_KEY=your-lapse-program-key

# Airtable personal access token (scope data.records:write on the base) + base/table
# that first-pass-approved projects are pushed to. Leave API key unset to disable.
AIRTABLE_API_KEY=your-airtable-pat
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=YSWS Project Submission
# Shared secret the Airtable approval automation sends in the X-Webhook-Secret header
# to POST /api/airtable/approve (e.g. `openssl rand -hex 32`, 32+ characters). Leave
# unset to disable.
AIRTABLE_WEBHOOK_SECRET=your-airtable-webhook-secret

# Slack app bot token (xoxb-...). Scopes: chat:write + im:write for DMs, channels:manage
# + groups:write to invite users to public/private channels. Leave unset to disable.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Comma-separated channel IDs that POST /api/slack/channels/join invites the caller to.
# The bot must already be a member of each one.
SLACK_JOIN_CHANNELS=C0123ABC,C0456DEF

# 32-byte AES-256 key, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts
# tokens stored at rest (User.HackatimeToken, User.HcaAccessToken/HcaRefreshToken).
# Rotating this makes existing encrypted values unreadable, so treat it like any other
# production secret.
TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Docker image only. Port to listen on (default 80; compose.yaml sets 8080), and set MIGRATE_ON_STARTUP=false to
# stop the container applying pending migrations on boot (on by default outside Development).
# PORT=8080
# MIGRATE_ON_STARTUP=true

# Image uploads (S3-compatible bucket, e.g. Cloudflare R2). Leave unset to disable
# POST /api/upload/image (it returns 503). S3_PUBLIC_URL is the bucket's public base URL
# (a custom domain, or r2.dev) that uploaded images are served from.
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_BUCKET_NAME=torque-uploads
S3_PUBLIC_URL=https://cdn.your-domain.com
