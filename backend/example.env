DB_CONNECTION_STRING=Host=<HOST>;Port=<PORT>;Database=postgres;Username=<username>;Password=<PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
FRONTEND_URL=http://localhost:9999
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=your-jwt-secret
# Public anon key, used by the /testing harness page. `supabase status` prints it.
SUPABASE_ANON_KEY=your-supabase-anon-key
# OIDC provider identifier the /testing harness signs in with
TESTING_OIDC_PROVIDER=custom:hackclub-auth
